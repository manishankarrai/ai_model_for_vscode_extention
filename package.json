{
  "name": "mm3-ai-agent",
  "displayName": "MM3 AI Agent",
  "description": "AI coding agent for investigating bugs, analyzing code, understanding projects, and answering development questions directly inside VS Code.",
  "version": "1.2.6",
  "publisher": "mm3ai",
  "icon": "media/mm3.png",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://www.mm3ai.com",
  "bugs": {
    "email": "support@mm3ai.com"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:mm3.chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mm3",
          "title": "MM3",
          "icon": "media/mm3.svg"
        }
      ]
    },
    "views": {
      "mm3": [
        {
          "id": "mm3.chat",
          "name": "MM3 AI Agent",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "mm3.openChat",
        "title": "MM3: Open Chat"
      },
      {
        "command": "mm3.clearConversation",
        "title": "MM3: Clear Conversation"
      },
      {
        "command": "mm3.rollbackLastChanges",
        "title": "MM3: Roll Back Last Approved Changes"
      },
      {
        "command": "mm3.addSelectionToChat",
        "title": "MM3: Add Selection to Chat"
      },
      {
        "command": "mm3.resetAccessToken",
        "title": "MM3: Reset Access Token",
        "icon": "$(key)"
      }
    ],
    "configuration": {
      "title": "MM3 AI Agent",
      "properties": {
        "mm3.backendUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "MM3 backend URL"
        },
        "mm3.maxContextChars": {
          "type": "number",
          "default": 300000,
          "description": "Maximum source context sent to the backend"
        },
        "mm3.maxFilesInContext": {
          "type": "number",
          "default": 30,
          "description": "Maximum files selected for AI context"
        },
        "mm3.implementationRoot": {
          "type": "string",
          "default": "",
          "description": "Optional workspace-relative directory to search and edit for implementation tasks"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "mm3.openChat",
          "when": "editorTextFocus"
        },
        {
          "command": "mm3.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ],
      "editor/title/context": [
        {
          "command": "mm3.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "watch": "npm run check-types && node esbuild.js --watch",
    "package": "npm run compile",
    "test": "node --experimental-strip-types --test src/agent/adaptiveRead.test.ts src/backend/agentEventStream.test.ts src/intelligence/contextSelection.test.ts src/intelligence/confidence.test.ts src/intelligence/InvestigationState.test.ts src/tools/toolPolicy.test.ts src/tools/commandPolicy.test.ts src/safety/changeValidation.test.ts src/quality/diffPreview.test.ts src/evaluation/evaluationSets.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0"
  }
}