{
  "name": "m3-ai-agent",
  "displayName": "M3 AI Agent",
  "description": "Read-only local-first AI coding agent for VS Code",
  "version": "0.0.1",
  "publisher": "m3-ai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:m3.chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "m3",
          "title": "M3",
          "icon": "media/m3.svg"
        }
      ]
    },
    "views": {
      "m3": [
        {
          "id": "m3.chat",
          "name": "M3 AI Agent",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "m3.openChat",
        "title": "M3: Open Chat"
      },
      {
        "command": "m3.scanProject",
        "title": "M3: Scan Project"
      },
      {
        "command": "m3.rebuildIndex",
        "title": "M3: Rebuild Index"
      },
      {
        "command": "m3.clearConversation",
        "title": "M3: Clear Conversation"
      },
      {
        "command": "m3.rollbackLastChanges",
        "title": "M3: Roll Back Last Approved Changes"
      },
      {
        "command": "m3.inspectProject",
        "title": "M3: Inspect Project"
      }
    ],
    "configuration": {
      "title": "M3 AI Agent",
      "properties": {
        "m3.backendUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "M3 backend URL"
        },
        "m3.maxContextChars": {
          "type": "number",
          "default": 300000,
          "description": "Maximum source context sent to the backend"
        },
        "m3.maxFilesInContext": {
          "type": "number",
          "default": 30,
          "description": "Maximum files selected for AI context"
        },
        "m3.enableAutoIndex": {
          "type": "boolean",
          "default": true,
          "description": "Automatically index the workspace"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "m3.openChat",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "watch": "npm run check-types && node esbuild.js --watch",
    "package": "npm run compile",
    "test": "node --experimental-strip-types --test src/intelligence/contextSelection.test.ts src/tools/toolPolicy.test.ts src/tools/commandPolicy.test.ts src/safety/changeValidation.test.ts src/quality/diffPreview.test.ts src/evaluation/evaluationSets.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0"
  }
}